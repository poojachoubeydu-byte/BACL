# ----------------------------------------------------------------------------
# Server-side only. These are NEVER bundled into the client — see vite.config.ts.
# ----------------------------------------------------------------------------

# Optional: set if you want the /api/enhance endpoint to call Gemini when the
# client requests ?mode=llm. Leave blank to run in deterministic template mode
# (no LLM calls, no cost).
GEMINI_API_KEY=

# Optional: server port (defaults to 8787).
PORT=8787

# Optional: Vite will proxy /api to this URL in dev. Leave default for local.
BCAL_API_URL=http://localhost:8787
